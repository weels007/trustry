# Every one of these has a working default, so nothing has to be set.
# They are here for the case where the contract moves or a different node is
# wanted, so that neither needs a change in the code.

# The node the browser talks to.
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# The Trustry contract that is read and written.
NEXT_PUBLIC_TRUSTRY_CONTRACT=0xf322db27dceD1AF28Db33756dff7f4D99205dA98

# The explorer the links point at.
NEXT_PUBLIC_GENLAYER_EXPLORER_URL=https://explorer-studio.genlayer.com
